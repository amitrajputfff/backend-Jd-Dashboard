# LiveKit credentials (same as voicebot_nodcode_platform/.env)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Comma-separated dispatch rule IDs that are protected (live production — cannot be reassigned from UI)
PROTECTED_DISPATCH_RULE_IDS=SDR_CSA2NurhzDxz

# MongoDB (no_code_platform / voicebot_platform / ai_lead_qualify databases)
MONGODB_URL=mongodb://127.0.0.1:27017

# Bot API URL defaults baked into newly-created assistants (editable per-agent
# afterwards). Point these at the environment's MIS/lead-qualification services.
MIS_API_BASE=http://192.168.8.67:8000
CALLBACK_API_URL=http://192.168.8.67:8000/leads/ai-lead-qualify/callback
CATEGORY_CHANGE_API=http://192.168.20.105:1080/services/abd/abd_beta.php

# TTS "Test Voice" preview (backend/routers/tts_preview.py) — same providers/keys
# voicebot_nodcode_platform/.env already uses for live calls. Required for the
# dashboard's real voice-preview playback (Sarvam bulbul:v3 voices need
# SARVAM_API_KEY; Justdial/IndicF5 voices need INDIC_TTS_WS_URL reachable from
# wherever this backend process runs).
SARVAM_API_KEY=
INDIC_TTS_WS_URL=ws://10.10.0.14:8404/ws

# Real dashboard login (backend/routers/auth.py) — JWT-signed access/refresh
# tokens. CHANGE JWT_SECRET before any real deployment — the code default is
# an insecure placeholder. Create your first login account with:
#   uv run python seed_admin_user.py you@justdial.com "a real password"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
